<?xml version="1.0" encoding="utf-8"?>
<!-- Loading placeholder with the same footprint as item_receipt. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_medium_rounded"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingVertical="10dp">

    <View
        android:id="@+id/skeleton_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar_circle"
        android:backgroundTint="@color/color_skeleton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/skeleton_title"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_marginStart="@dimen/spacing_md"
        android:layout_marginEnd="60dp"
        android:background="@drawable/bg_small_rounded"
        android:backgroundTint="@color/color_skeleton"
        app:layout_constraintBottom_toTopOf="@id/skeleton_subtitle"
        app:layout_constraintEnd_toStartOf="@id/skeleton_amount"
        app:layout_constraintStart_toEndOf="@id/skeleton_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <View
        android:id="@+id/skeleton_subtitle"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="@dimen/spacing_sm"
        android:layout_marginEnd="30dp"
        android:background="@drawable/bg_small_rounded"
        android:backgroundTint="@color/color_skeleton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/skeleton_title"
        app:layout_constraintStart_toStartOf="@id/skeleton_title"
        app:layout_constraintTop_toBottomOf="@id/skeleton_title" />

    <View
        android:id="@+id/skeleton_amount"
        android:layout_width="56dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_small_rounded"
        android:backgroundTint="@color/color_skeleton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
