<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_rounded"
    android:padding="16dp">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_title"
        style="@style/TextAppearance.Moner.Bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New Category"
        android:textSize="18sp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.alviy.moner.core.designsystem.CustomTextField
        android:id="@+id/tf_category_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hintText="Category Name"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_primary"
        app:layout_constraintTop_toBottomOf="@id/tv_title"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_primary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/color_btn_primary"
        android:elevation="0dp"
        android:gravity="center"
        android:paddingHorizontal="36dp"
        android:paddingVertical="0dp"
        android:text="Add Category"
        android:enabled="false"
        android:textAppearance="@style/TextAppearance.Moner.Bold"
        android:textColor="@color/color_text_btn_primary"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="1"
        app:rippleColor="@color/colorRipple"
        app:shapeAppearance="@style/Shape.RoundedButton" />


</androidx.constraintlayout.widget.ConstraintLayout>