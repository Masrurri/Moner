<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_96">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                style="@style/Widget.Moner.Text.PageTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/budget_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_month"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Moner.SemiBold"
                android:textColor="@color/color_text_primary"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textEnd"
                app:iconSize="@dimen/size_18"
                app:iconTint="@color/color_text_primary"
                tools:text="Select Date" />

        </LinearLayout>

        <!-- Spent of budget -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Moner.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20"
            app:cardBackgroundColor="@color/color_surface_ink"
            app:cardCornerRadius="@dimen/radius_20">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_20">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_spent_label"
                    style="@style/Widget.Moner.Text.Overline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/budget_spent_of_budget"
                    android:textColor="@color/color_text_on_ink"
                    app:layout_constraintEnd_toStartOf="@id/progress_ring"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_spent_amount"
                    style="@style/Widget.Moner.Text.PageTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textColor="@color/color_text_on_ink"
                    app:layout_constraintEnd_toStartOf="@id/progress_ring"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_spent_label"
                    tools:text="Rp 3.100.000" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_limit_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:textAppearance="@style/TextAppearance.Moner.Regular"
                    android:textColor="@color/color_fixed_on_ink_secondary"
                    android:textSize="@dimen/text_14"
                    app:layout_constraintEnd_toStartOf="@id/progress_ring"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_spent_amount"
                    tools:text="/ Rp 5.000.000" />

                <com.alviy.moner.core.designsystem.component.CircularProgressView
                    android:id="@+id/progress_ring"
                    android:layout_width="@dimen/size_56"
                    android:layout_height="@dimen/size_56"
                    app:cpv_progressColor="@color/color_accent_neon"
                    app:cpv_strokeWidth="@dimen/stroke_6"
                    app:cpv_trackColor="@color/color_progress_track_on_ink"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/budget_category_budgets"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textSize="@dimen/text_16" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_category_budgets"
            style="@style/Widget.Moner.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_category_budgets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_16"
                android:paddingVertical="@dimen/space_4"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@layout/item_category_budget" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_empty_state"
            style="@style/Widget.Moner.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_12"
            android:visibility="gone">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_empty_state"
                style="@style/Widget.Moner.Text.EmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_20"
                android:text="@string/budget_empty_state" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_category_budget"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/space_12"
            android:text="@string/budget_add_category_budget"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/color_text_primary"
            app:cornerRadius="@dimen/radius_16"
            app:icon="@drawable/ic_plus"
            app:iconTint="@color/color_text_primary"
            app:strokeColor="@color/color_stroke_hairline" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
