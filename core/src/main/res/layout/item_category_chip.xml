<?xml version="1.0" encoding="utf-8"?><!-- Pill for one SpendCategory. Colors, icon and text are set per category in Chip.bindCategory(). -->
<com.google.android.material.chip.Chip xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.MaterialComponents.Chip.Choice"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textAppearance="@style/TextAppearance.Moner.SemiBold"
    android:textSize="12sp"
    app:checkedIconVisible="false"
    app:chipCornerRadius="100dp"
    app:chipEndPadding="0dp"
    app:chipIconSize="14dp"
    app:chipIconVisible="true"
    app:chipMinHeight="30dp"
    app:chipStartPadding="10dp"
    app:chipStrokeWidth="1dp"
    app:ensureMinTouchTargetSize="false"
    app:iconEndPadding="0dp"
    app:iconStartPadding="0dp"
    app:textEndPadding="14dp"
    app:textStartPadding="6dp"
    tools:chipBackgroundColor="@color/category_food_container"
    tools:chipIcon="@drawable/ic_category_food"
    tools:text="Food"
    tools:textColor="@color/category_food_content" />
