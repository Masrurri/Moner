<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark counterparts of the themed tokens in values/colors.xml. Fixed tokens are not repeated here. -->

    <!-- Base -->
    <color name="black">#F5F5F5</color>
    <color name="white">#111111</color>
    <color name="transparent">#00000000</color>

    <!-- Surfaces -->
    <color name="color_bg_app">#121212</color>
    <color name="color_bg_surface">#1E1E1E</color>
    <color name="color_surface_ink">#000000</color>
    <color name="color_stroke_hairline">#2A2A2A</color>
    <color name="color_shadow">#66000000</color>
    <color name="color_ripple">#33FFFFFF</color>
    <color name="color_input_bg">#242424</color>

    <!-- Text -->
    <color name="color_text_primary">#F5F5F5</color>
    <color name="color_text_secondary">#9A9A9A</color>
    <color name="color_text_tertiary">#6E6E6E</color>
    <color name="color_text_on_ink">#F5F5F5</color>

    <!-- Accent (neon stays constant across themes; on-neon content stays dark for contrast) -->
    <color name="color_accent_neon">#D6FF3F</color>
    <color name="color_on_neon">#111111</color>
    <color name="color_danger">#FF6B5E</color>

    <!-- Buttons (flip with theme) -->
    <color name="color_button_primary_bg">#F5F5F5</color>
    <color name="color_button_primary_bg_pressed">#D8D8D8</color>
    <color name="color_button_primary_text">#111111</color>

    <!-- Pills / chips -->
    <color name="color_pill_bg_unselected">#242424</color>
    <color name="color_pill_text_unselected">#F5F5F5</color>

    <!-- Bottom nav: active content stays ink-dark for contrast -->
    <color name="color_nav_icon_inactive">#6E6E6E</color>
    <color name="color_nav_active_content">#111111</color>
</resources>
