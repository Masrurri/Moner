<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    tools:context=".ui.HomeFragment">

    <!-- Total expense card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_bottom"
        android:backgroundTint="@color/color_surface_dark"
        android:padding="@dimen/spacing_lg"
        android:translationZ="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_avatar"
            app:layout_constraintBottom_toBottomOf="@id/tv_welcome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_greeting" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/home_greeting"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/white_grey"
            android:textSize="@dimen/text_size_lg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/home_welcome_back"
            android:textAppearance="@style/TextAppearance.Moner.Regular"
            android:textColor="@color/color_text_on_dark_secondary"
            android:textSize="@dimen/text_size_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toBottomOf="@id/tv_greeting" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_total_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:letterSpacing="0.02"
            android:text="@string/home_total_spend"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/color_text_on_dark_secondary"
            android:textSize="@dimen/text_size_lg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_welcome" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_selected_month"
            style="@style/Widget.Moner.Button.PillsIcon"
            android:layout_width="wrap_content"
            android:backgroundTint="#2A2A2A"
            android:text="@string/home_select_time_default"
            android:textColor="@color/color_text_on_dark_secondary"
            android:textSize="@dimen/text_size_sm"
            app:iconTint="#2A2A2A"
            app:layout_constraintBottom_toBottomOf="@id/tv_total_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_total_label"
            app:rippleColor="@color/color_ripple_grey" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_total_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:textAppearance="@style/TextAppearance.Moner.Bold"
            android:textColor="@color/white_grey"
            android:textSize="@dimen/text_size_display"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_selected_month"
            tools:text="Rp 4.250.000" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_spend"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:backgroundTint="#2D2E32"
            android:text="@string/home_action_spend"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/white"
            app:backgroundTint="#2D2E32"
            app:cornerRadius="@dimen/radius_field"
            app:icon="@drawable/ic_add_square"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/btn_scan"
            app:layout_constraintTop_toBottomOf="@id/tv_total_amount"
            app:rippleColor="@color/color_ripple_light"
            app:strokeColor="#4E4F53"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_receipt"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:backgroundTint="#2D2E32"
            android:text="@string/home_action_receipt"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/white"
            app:backgroundTint="#2D2E32"
            app:cornerRadius="@dimen/radius_field"
            app:icon="@drawable/ic_receipt"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/white"
            app:layout_constraintEnd_toStartOf="@id/btn_scan"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_total_amount"
            app:rippleColor="@color/color_ripple_light"
            app:strokeColor="#4E4F53"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_scan"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_2xs"
            android:layout_marginTop="@dimen/spacing_lg"
            android:backgroundTint="#2D2E32"
            android:text="@string/home_action_scan"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/white"
            app:backgroundTint="#2D2E32"
            app:cornerRadius="@dimen/radius_field"
            app:icon="@drawable/ic_scan"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/white"
            app:layout_constraintEnd_toStartOf="@id/btn_spend"
            app:layout_constraintStart_toEndOf="@id/btn_receipt"
            app:layout_constraintTop_toBottomOf="@id/tv_total_amount"
            app:rippleColor="@color/color_ripple_light"
            app:strokeColor="#4E4F53"
            app:strokeWidth="1dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_money_today"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_rounded_md"
            app:layout_constraintEnd_toStartOf="@+id/cl_money_week"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_scan">

            <ImageView
                android:id="@+id/iv_spend_today"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:src="@drawable/ic_money_out_red"
                app:layout_constraintBottom_toBottomOf="@id/tv_spend_today_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_spend_today_label" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_today_label"
                style="@style/Widget.Moner.StatLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:text="@string/home_spend_today"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_today"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_today_value"
                style="@style/Widget.Moner.StatValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_today"
                app:layout_constraintTop_toBottomOf="@id/tv_spend_today_label"
                app:layout_constraintVertical_bias="1"
                tools:text="Rp 4.250.000" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_money_week"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_rounded_md"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/cl_money_today"
            app:layout_constraintTop_toBottomOf="@id/btn_scan">

            <ImageView
                android:id="@+id/iv_spend_week"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:src="@drawable/ic_money_out_blue"
                app:layout_constraintBottom_toBottomOf="@id/tv_spend_week_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_spend_week_label" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_week_label"
                style="@style/Widget.Moner.StatLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginEnd="@dimen/spacing_md"
                android:text="@string/home_spend_week"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_week"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_week_value"
                style="@style/Widget.Moner.StatValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_week"
                app:layout_constraintTop_toBottomOf="@id/tv_spend_week_label"
                app:layout_constraintVertical_bias="1"
                tools:text="Rp 4.250.000" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_spend_limit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:background="@drawable/bg_rounded_md"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/cl_money_week"
            app:layout_constraintStart_toStartOf="@id/cl_money_today"
            app:layout_constraintTop_toBottomOf="@id/cl_money_today">

            <ImageView
                android:id="@+id/iv_limit"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="@dimen/spacing_lg"
                android:layout_marginEnd="@dimen/spacing_lg"
                android:src="@drawable/ic_limit_square"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_limit_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/home_spend_limit"
                android:textAppearance="@style/TextAppearance.Moner.Regular"
                android:textColor="@color/color_text_on_dark_secondary"
                android:textSize="@dimen/text_size_sm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_limit_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:textAppearance="@style/TextAppearance.Moner.Bold"
                android:textColor="@color/white_grey"
                android:textSize="@dimen/text_size_md"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_limit_label"
                tools:text="Rp 4.250.000" />

            <com.alviy.moner.core.designsystem.LinearProgressView
                android:id="@+id/lpv"
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_md"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_limit_value"
                app:lpv_progress="0.2"
                app:lpv_strokeWidth="6dp"
                app:lpv_trackColor="#333333" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_limit_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.Moner.SemiBold"
                android:textColor="@color/white"
                android:textSize="@dimen/text_size_md"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lpv"
                app:layout_constraintVertical_bias="0"
                app:layout_goneMarginBottom="@dimen/spacing_lg"
                tools:text="Rp 5.000.000" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_set_limit"
                style="@style/Widget.Moner.Button.PillsIcon"
                android:layout_width="100dp"
                android:layout_height="30dp"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:backgroundTint="#333333"
                android:text="Set Limit"
                android:textColor="@color/white_grey"
                android:textSize="@dimen/text_size_sm"
                android:visibility="gone"
                app:cornerRadius="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lpv"
                app:layout_constraintVertical_bias="0"
                app:rippleColor="@color/color_ripple_grey" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Anchor: how far the scroll area overlaps up into cl_header -->
    <Space
        android:id="@+id/space_header_overlap"
        android:layout_width="0dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="@id/cl_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Scrollable content below the header -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="24dp"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/space_header_overlap">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Recent transactions header row -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_recent_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_lg"
                android:layout_marginTop="@dimen/spacing_lg"
                android:text="@string/home_recent_transactions"
                android:textAppearance="@style/TextAppearance.Moner.SemiBold"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_size_lg"
                app:layout_constraintEnd_toStartOf="@id/btn_see_all"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_see_all"
                style="@style/Widget.Moner.Button.PillsIcon"
                android:layout_width="90dp"
                android:layout_marginEnd="@dimen/spacing_lg"
                android:text="@string/home_see_all"
                app:layout_constraintBottom_toBottomOf="@id/tv_recent_header"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_recent_header" />

            <!-- Transactions list (scrolls with the NestedScrollView) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_transactions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_lg"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_recent_header"
                tools:itemCount="4"
                tools:listitem="@layout/item_recent_transaction" />

            <!-- Empty state (overlaps rv_transactions area) -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_empty_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:padding="@dimen/spacing_2xl"
                android:text="@string/home_empty_state"
                android:textAppearance="@style/TextAppearance.Moner.Regular"
                android:textColor="@color/color_text_secondary"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_see_all" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>