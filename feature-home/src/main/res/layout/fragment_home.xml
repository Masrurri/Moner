<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fixed_background_dark"
    tools:context=".ui.HomeFragment">

    <!-- Header: greeting, total spending, quick actions and stat cards -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_bottom"
        android:padding="@dimen/space_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/size_32"
            android:layout_height="@dimen/size_32"
            android:contentDescription="@null"
            android:src="@drawable/ic_avatar"
            app:layout_constraintBottom_toBottomOf="@id/tv_welcome"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_greeting" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/home_greeting_placeholder"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textSize="@dimen/text_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_welcome"
            style="@style/Widget.Moner.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:text="@string/home_welcome_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toBottomOf="@id/tv_greeting" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_total_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:letterSpacing="0.02"
            android:text="@string/home_total_expense"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_welcome" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_selected_month"
            style="@style/Widget.Moner.Button.PillsIcon"
            android:layout_width="0dp"
            android:backgroundTint="@color/color_month_chip_bg"
            android:text="@string/home_select_time_default"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_12"
            app:icon="@drawable/ic_arrow_bottom_filled"
            app:iconTint="@color/color_text_secondary"
            app:layout_constraintBottom_toBottomOf="@id/tv_total_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_total_label"
            app:rippleColor="@color/color_month_chip_ripple" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_total_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.Moner.Bold"
            android:textColor="@color/color_fixed_text_dark"
            android:textSize="@dimen/text_30"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_selected_month"
            tools:text="Rp 4.250.000" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_delta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Moner.Regular"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_13"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_total_amount"
            tools:text="5% vs last month" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_spend"
            style="@style/Widget.Moner.Button.QuickAction.Dark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/home_action_spend"
            app:icon="@drawable/ic_add_square"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/btn_stats"
            app:layout_constraintTop_toBottomOf="@id/tv_delta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fetch"
            style="@style/Widget.Moner.Button.QuickAction.Light"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/home_action_fetch"
            app:icon="@drawable/ic_fetch_square"
            app:layout_constraintEnd_toStartOf="@id/btn_stats"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_delta" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_stats"
            style="@style/Widget.Moner.Button.QuickAction.Light"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_4"
            android:layout_marginTop="@dimen/space_16"
            android:text="@string/home_action_stats"
            app:icon="@drawable/ic_chart_square"
            app:layout_constraintEnd_toStartOf="@id/btn_spend"
            app:layout_constraintStart_toEndOf="@id/btn_fetch"
            app:layout_constraintTop_toBottomOf="@id/tv_delta" />

        <!-- Money out today -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/first_stat_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_50"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginEnd="@dimen/space_6"
            android:background="@drawable/bg_rounded"
            app:layout_constraintEnd_toStartOf="@+id/second_stat_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_fetch">

            <ImageView
                android:id="@+id/iv_spend_today"
                style="@style/Widget.Moner.Home.StatIcon"
                app:layout_constraintBottom_toBottomOf="@id/tv_spend_today_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_spend_today_label" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_today_label"
                style="@style/Widget.Moner.Home.StatLabel"
                android:text="@string/home_money_out_today"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_today"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_today_value"
                style="@style/Widget.Moner.Home.StatValue"
                android:text="@string/home_placeholder_spent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_today"
                app:layout_constraintTop_toBottomOf="@id/tv_spend_today_label"
                app:layout_constraintVertical_bias="1" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Money out this week -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/week_stat_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/size_50"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_12"
            android:background="@drawable/bg_rounded"
            app:layout_constraintEnd_toStartOf="@+id/second_stat_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/first_stat_container">

            <ImageView
                android:id="@+id/iv_spend_week"
                style="@style/Widget.Moner.Home.StatIcon"
                app:layout_constraintBottom_toBottomOf="@id/tv_spend_week_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_spend_week_label" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_week_label"
                style="@style/Widget.Moner.Home.StatLabel"
                android:text="@string/home_money_out_week"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_week"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_week_value"
                style="@style/Widget.Moner.Home.StatValue"
                android:text="@string/home_placeholder_spent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_week"
                app:layout_constraintTop_toBottomOf="@id/tv_spend_week_label"
                app:layout_constraintVertical_bias="1" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Spending limit -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/second_stat_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/space_6"
            android:background="@drawable/bg_rounded"
            app:layout_constraintBottom_toBottomOf="@id/week_stat_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/first_stat_container"
            app:layout_constraintTop_toTopOf="@id/first_stat_container">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_limit_label"
                style="@style/Widget.Moner.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_12"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/home_spending_limit"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.alviy.moner.core.designsystem.component.LinearProgressView
                android:id="@+id/lpv"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_12"
                android:layout_marginHorizontal="@dimen/space_12"
                android:layout_marginTop="@dimen/space_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_limit_label"
                app:lpv_progress="0.2"
                app:lpv_progressColor="@color/color_fixed_text_dark"
                app:lpv_strokeWidth="@dimen/stroke_6"
                app:lpv_trackColor="@color/color_progress_track_light" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_limit_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_12"
                android:layout_marginTop="@dimen/space_2"
                android:layout_marginBottom="@dimen/space_12"
                android:text="@string/home_placeholder_spent"
                android:textAppearance="@style/TextAppearance.Moner.Bold"
                android:textColor="@color/color_fixed_text_dark"
                android:textSize="@dimen/text_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_limit_total"
                app:layout_constraintVertical_bias="1" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_limit_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_12"
                android:layout_marginBottom="@dimen/space_12"
                android:gravity="end"
                android:text="@string/home_placeholder_limit"
                android:textAppearance="@style/TextAppearance.Moner.Regular"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lpv" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Recent transactions header row -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_recent_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_16"
        android:text="@string/home_recent_transactions"
        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
        android:textColor="@color/white"
        android:textSize="@dimen/text_16"
        app:layout_constraintBottom_toBottomOf="@id/btn_see_all"
        app:layout_constraintEnd_toStartOf="@id/btn_see_all"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_see_all" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_see_all"
        style="@style/Widget.Moner.Button.PillsIcon"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:layout_marginEnd="@dimen/space_16"
        android:text="@string/home_see_all"
        app:icon="@drawable/ic_arrow_right_filled"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_header"
        app:strokeColor="@color/color_fixed_stroke_dark"
        app:strokeWidth="@dimen/stroke_1" />

    <!-- Transactions: the only scrollable element -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_transactions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginTop="@dimen/space_4"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="@dimen/space_96"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_see_all"
        tools:itemCount="4"
        tools:listitem="@layout/item_home_transaction" />

    <!-- Empty state (overlaps rv_transactions area) -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_empty_state"
        style="@style/Widget.Moner.Text.EmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_24"
        android:text="@string/home_empty_state"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_transactions"
        app:layout_constraintEnd_toEndOf="@id/rv_transactions"
        app:layout_constraintStart_toStartOf="@id/rv_transactions"
        app:layout_constraintTop_toTopOf="@id/rv_transactions" />

</androidx.constraintlayout.widget.ConstraintLayout>
