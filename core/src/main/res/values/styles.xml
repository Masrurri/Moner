<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance">
        <item name="fontFamily">@font/inter_family</item>
    </style>

    <style name="TextAppearance.Moner">
        <item name="fontFamily">@font/inter_family</item>
    </style>

    <style name="TextAppearance.Moner.Thin" parent="TextAppearance.Moner">
        <item name="android:textFontWeight">100</item>
        <item name="android:textColor">@color/color_text_tertiary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Moner.Regular" parent="TextAppearance.Moner">
        <item name="font">@font/inter</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Moner.Bold" parent="TextAppearance.Moner">
        <item name="font">@font/inter_bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Moner.Medium" parent="TextAppearance.Moner">
        <item name="font">@font/inter_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Moner.SemiBold" parent="TextAppearance.Moner">
        <item name="font">@font/inter_semibold</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Moner.AmountDisplay" parent="TextAppearance.Moner">
        <item name="font">@font/inter_bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">40sp</item>
    </style>

    <style name="Shape.RoundedButton" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.Moner.FullScreenSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Moner.FullScreenSheet.Modal</item>
    </style>

    <style name="Widget.Moner.FullScreenSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.Moner.Sheet</item>
        <item name="backgroundTint">@color/color_bg_app</item>
    </style>

    <style name="RoundedDialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <!-- Shared shapes (single source of truth for the design system) -->
    <style name="ShapeAppearance.Moner.BottomNav"
        parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">40dp</item>
        <item name="cornerSizeTopRight">40dp</item>
        <item name="cornerSizeBottomLeft">40dp</item>
        <item name="cornerSizeBottomRight">40dp</item>
    </style>

    <style name="ShapeAppearance.Moner.NavActivePill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.Moner.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#333333</item>
        <item name="android:width">90dp</item>
        <item name="android:height">40dp</item>
        <item name="marginHorizontal">2dp</item>
    </style>

    <style name="ShapeAppearance.Moner.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.MaterialComponents.CardView.Nav" parent="Widget.Moner.MaterialCardView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Moner.BottomNav</item>
    </style>

    <style name="Widget.Moner.Hairline" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@drawable/bg_row_hairline</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
    </style>

    <style name="Widget.Moner.MaterialCardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_bg_surface</item>
        <item name="android:outlineAmbientShadowColor">@color/color_shadow</item>
        <item name="android:outlineSpotShadowColor">@color/color_shadow</item>
        <item name="cardElevation">18dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">@color/transparent</item>
    </style>

    <!-- Monthly / Weekly style segmented control (2 fixed options via MaterialButtonToggleGroup) -->
    <style name="ShapeAppearance.Moner.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.Moner.SegmentedControl.Button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.Moner.SemiBold</item>
        <item name="android:textColor">@color/color_pill_text</item>
        <item name="backgroundTint">@color/color_pill_bg</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Moner.Pill</item>
        <item name="rippleColor">@color/color_ripple</item>
    </style>

    <style name="Widget.Moner.Button.PillsIcon" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:backgroundTint">#1C1C1C</item>
        <item name="android:textAppearance">@style/TextAppearance.Moner.SemiBold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="backgroundTint">@color/white</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconPadding">6dp</item>
        <item name="iconSize">12dp</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">#33C1C1C1</item>
        <item name="elevation">0dp</item>
    </style>

</resources>
