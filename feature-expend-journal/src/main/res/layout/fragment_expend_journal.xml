<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    tools:context="com.alviy.feature.expend.journal.ui.ExpendJournalFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iv_profile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_profile_default"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_name"
                style="@style/TextAppearance.Moner.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Hey, Jarot"
                android:textSize="14sp"
                app:layout_constraintStart_toEndOf="@id/iv_profile"
                app:layout_constraintTop_toTopOf="@id/iv_profile" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_greet"
                style="@style/TextAppearance.Moner.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back"
                android:textColor="@color/thin_text"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/tv_name"
                app:layout_constraintTop_toBottomOf="@id/tv_name" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_total_label"
                style="@style/TextAppearance.Moner.Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Total Expense"
                android:textColor="#636363"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="@id/iv_profile"
                app:layout_constraintTop_toBottomOf="@id/iv_profile" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_time"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginHorizontal="16dp"
                android:backgroundTint="@color/lightGrey"
                android:elevation="0dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="0dp"
                android:text="Select Time"
                android:textAppearance="@style/TextAppearance.Moner.SemiBold"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_name"
                app:rippleColor="@color/colorRipple"
                app:shapeAppearance="@style/Shape.RoundedButton" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_total_amount"
                style="@style/TextAppearance.Moner.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="0"
                android:textSize="32sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@id/tv_total_label"
                app:layout_constraintTop_toBottomOf="@id/tv_total_label" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_latest_expense"
                style="@style/TextAppearance.Moner.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="8dp"
                android:text="+0"
                android:textColor="@color/thin_text"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/tv_total_amount"
                app:layout_constraintStart_toEndOf="@id/tv_total_amount" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_category"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/white"
        android:elevation="0dp"
        android:gravity="center"
        android:paddingHorizontal="0dp"
        android:paddingVertical="0dp"
        android:text="+"
        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_profile"
        app:rippleColor="@color/colorRipple"
        app:shapeAppearance="@style/Shape.RoundedButton" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_add_category"
        app:layout_constraintTop_toBottomOf="@id/cv_profile"
        tools:itemCount="4"
        tools:listitem="@layout/item_pills_category" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_journal_section"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_category"
        tools:itemCount="4"
        tools:listitem="@layout/item_journal_section" />

</androidx.constraintlayout.widget.ConstraintLayout>