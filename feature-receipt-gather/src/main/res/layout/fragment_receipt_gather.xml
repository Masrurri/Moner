<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_grey"
    tools:context=".ui.ReceiptGatherFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_bottom"
        android:backgroundTint="@color/white"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:translationZ="22dp"
        android:outlineSpotShadowColor="@color/color_shadow"
        android:outlineAmbientShadowColor="@color/color_shadow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Moner.Bold"
            android:textSize="22sp"
            android:layout_marginTop="@dimen/spacing_lg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints"
            android:text="@string/receipt_gather_title" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/receipt_gather_subtitle"
            android:textAppearance="@style/TextAppearance.Moner.Regular"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_size_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@id/tv_title"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <!-- Google account chip: shows the email when connected, tap to connect otherwise. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcv_google"
            style="@style/Widget.Moner.MaterialCardView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_xl"
            app:cardBackgroundColor="@color/color_bg_google_chip"
            app:cardCornerRadius="20dp"
            app:rippleColor="@color/color_ripple_grey"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

            <com.alviy.moner.core.designsystem.ShimmerLayout
                android:id="@+id/shimmer_google"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:shimmer_maskToContent="false">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/spacing_sm"
                    android:paddingHorizontal="10dp">

                    <ImageView
                        android:id="@+id/iv_google"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_google"
                        app:layout_constraintBottom_toBottomOf="@id/tv_google_desc"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_google_desc"
                        app:tint="@color/color_icon_muted" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_google_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:text="@string/receipt_gather_google_connect"
                        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_size_xs"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_google"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.alviy.moner.core.designsystem.ShimmerLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_receipts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="96dp"
        android:paddingTop="30dp"
        android:layout_marginTop="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:itemCount="4"
        tools:listitem="@layout/item_receipt" />

    <!-- Skeleton shown over the list while receipts are being fetched. -->
    <com.alviy.moner.core.designsystem.ShimmerLayout
        android:id="@+id/shimmer_receipts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="120dp"
        android:paddingTop="30dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/item_receipt_skeleton" />
            <include layout="@layout/item_receipt_skeleton" />
            <include layout="@layout/item_receipt_skeleton" />
            <include layout="@layout/item_receipt_skeleton" />
            <include layout="@layout/item_receipt_skeleton" />
            <include layout="@layout/item_receipt_skeleton" />

        </LinearLayout>

    </com.alviy.moner.core.designsystem.ShimmerLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_fetch"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_xs"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/color_btn_dark"
        android:enabled="false"
        android:text="@string/receipt_gather_fetch"
        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
        android:textColor="@color/color_btn_dark_content"
        app:backgroundTint="@color/color_btn_dark"
        app:cornerRadius="@dimen/radius_md"
        app:icon="@drawable/ic_fetch_square"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconSize="20dp"
        app:iconTint="@color/color_btn_dark_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_scan"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@color/color_ripple_light" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_scan"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="@dimen/spacing_xs"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/color_surface_dark"
        android:text="@string/receipt_gather_scan"
        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
        android:textColor="@color/white"
        app:backgroundTint="@color/color_surface_dark"
        app:cornerRadius="@dimen/radius_md"
        app:icon="@drawable/ic_scan"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconSize="20dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/btn_fetch"
        app:rippleColor="@color/color_ripple_light" />

</androidx.constraintlayout.widget.ConstraintLayout>
