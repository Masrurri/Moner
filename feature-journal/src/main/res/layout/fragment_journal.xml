<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    tools:context=".ui.JournalFragment">

    <!-- Total expense card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_bottom"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="16dp">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textSize="16sp"
            tools:text="Hey, Moner"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:ignore="MissingConstraints" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/journal_welcome_back"
            android:textAppearance="@style/TextAppearance.Moner.Regular"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_greeting"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_total_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:layout_marginTop="16dp"
            android:text="@string/journal_total_expense"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/progress_ring"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_welcome" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_total_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Moner.Bold"
            android:textColor="#121212"
            android:textSize="26sp"
            app:layout_constraintEnd_toStartOf="@id/progress_ring"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_total_label"
            tools:text="Rp 4.250.000" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_delta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Moner.Regular"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/progress_ring"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_total_amount"
            tools:text="5% vs last month" />

        <com.alviy.moner.core.designsystem.CircularProgressView
            android:id="@+id/progress_ring"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cpv_progressColor="@color/color_accent_neon"
            app:cpv_trackColor="#33858585"
            app:cpv_strokeWidth="6dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_delta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_total_label" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_spend"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/white"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_marginTop="16dp"
            android:textColor="@color/black"
            android:drawableTint="@color/black"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:text="Spend"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_arrow_right"
            app:layout_constraintTop_toBottomOf="@id/tv_delta"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Category filter pills -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_category"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="16dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_header"
        tools:itemCount="4"
        tools:listitem="@layout/item_pills" />

    <!-- Recent transactions header row -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_recent_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/journal_recent_transactions"
        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@id/cl_selected_date"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cl_selected_date"
        app:layout_constraintTop_toTopOf="@id/cl_selected_date" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_selected_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rv_category">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_selected_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Date"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/color_surface_ink"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Transactions RecyclerView — only scrollable element -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_transactions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="96dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_selected_date"
        tools:itemCount="4"
        tools:listitem="@layout/item_journal" />

    <!-- Empty state (overlaps rv_transactions area) -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/journal_empty_state"
        android:textAppearance="@style/TextAppearance.Moner.Regular"
        android:textColor="@color/color_text_secondary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_transactions"
        app:layout_constraintEnd_toEndOf="@id/rv_transactions"
        app:layout_constraintStart_toStartOf="@id/rv_transactions"
        app:layout_constraintTop_toTopOf="@id/rv_transactions" />

</androidx.constraintlayout.widget.ConstraintLayout>