<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_mock_transactions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/color_btn_primary"
        android:elevation="0dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:text="Mock Transactions"
        android:textAppearance="@style/TextAppearance.Moner.Bold"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:icon="@drawable/ic_add_circle"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="32dp"
        app:iconTint="@null"
        app:layout_constraintBottom_toTopOf="@id/btn_generate_template"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@color/colorRipple"
        app:shapeAppearance="@style/Shape.RoundedButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_generate_template"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/color_btn_primary"
        android:elevation="0dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:text="Generate Template"
        android:textAppearance="@style/TextAppearance.Moner.Bold"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:icon="@drawable/ic_add_circle"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="32dp"
        app:iconTint="@null"
        app:layout_constraintBottom_toTopOf="@id/btn_clear_db"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@color/colorRipple"
        app:shapeAppearance="@style/Shape.RoundedButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_clear_db"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/color_btn_primary"
        android:elevation="0dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:text="Clear Database"
        android:textAppearance="@style/TextAppearance.Moner.Bold"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:icon="@drawable/ic_close_circle"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="32dp"
        app:iconTint="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:rippleColor="@color/colorRipple"
        app:shapeAppearance="@style/Shape.RoundedButton" />

</androidx.constraintlayout.widget.ConstraintLayout>