<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#151515"
    tools:context=".ui.JournalFragment">

    <!-- Total expense card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_bottom"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_greeting"
            app:layout_constraintBottom_toBottomOf="@id/tv_welcome"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints"
            android:text="Hey, Punk" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/journal_welcome_back"
            android:textAppearance="@style/TextAppearance.Moner.Regular"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toBottomOf="@id/tv_greeting" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_total_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.02"
            android:text="@string/journal_total_expense"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/color_text_secondary"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_welcome" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_selected_month"
            style="@style/Widget.Moner.Button.PillsIcon"
            android:layout_width="0dp"
            android:text="This Month"
            android:textSize="12sp"
            app:iconTint="@color/color_text_secondary"
            android:textColor="@color/color_text_secondary"
            android:backgroundTint="#DCDDDE"
            app:rippleColor="#33A8A8A8"
            app:icon="@drawable/ic_arrow_bottom_filled"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tv_total_label"
            app:layout_constraintTop_toTopOf="@id/tv_total_label" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_total_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Moner.Bold"
            android:textColor="#121212"
            android:textSize="30sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_selected_month"
            tools:text="Rp 4.250.000" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_delta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Moner.Regular"
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_total_amount"
            tools:text="5% vs last month" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_spend"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#1C1C1C"
            android:text="Spend"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/white"
            app:backgroundTint="#1C1C1C"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_add_square"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:layout_constraintHorizontal_bias="0"
            app:iconTint="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_stats"
            app:layout_constraintTop_toBottomOf="@id/tv_delta"
            app:rippleColor="#33C1C1C1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fetch"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/white"
            android:text="Fetch"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_fetch_square"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/black"
            app:layout_constraintEnd_toStartOf="@id/btn_stats"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_delta"
            app:rippleColor="#33C1C1C1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_stats"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="@color/white"
            android:text="Stats"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_chart_square"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/black"
            app:layout_constraintEnd_toStartOf="@id/btn_spend"
            app:layout_constraintStart_toEndOf="@id/btn_fetch"
            app:layout_constraintTop_toBottomOf="@id/tv_delta"
            app:rippleColor="#33C1C1C1" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/first_stat_container"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_rounded"
            app:layout_constraintEnd_toStartOf="@+id/second_stat_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_fetch">

            <ImageView
                android:id="@+id/iv_spend_today"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_export"
                app:layout_constraintBottom_toBottomOf="@id/tv_spend_today_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_spend_today_label" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_today_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:text="Money out today"
                android:textAppearance="@style/TextAppearance.Moner.Regular"
                android:textColor="@color/color_text_secondary"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_today"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_today_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"
                android:text="Rp 4.250.000"
                android:textAppearance="@style/TextAppearance.Moner.Bold"
                android:textColor="#121212"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_today"
                app:layout_constraintTop_toBottomOf="@id/tv_spend_today_label"
                app:layout_constraintVertical_bias="1" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/week_stat_container"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_rounded"
            app:layout_constraintEnd_toStartOf="@+id/second_stat_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/first_stat_container">

            <ImageView
                android:id="@+id/iv_spend_week"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/ic_export"
                app:layout_constraintBottom_toBottomOf="@id/tv_spend_week_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_spend_week_label" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_week_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="12dp"
                android:text="Money out this week"
                android:textAppearance="@style/TextAppearance.Moner.Regular"
                android:textColor="@color/color_text_secondary"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_week"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_week_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"
                android:text="Rp 4.250.000"
                android:textAppearance="@style/TextAppearance.Moner.Bold"
                android:textColor="#121212"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_week"
                app:layout_constraintTop_toBottomOf="@id/tv_spend_week_label"
                app:layout_constraintVertical_bias="1" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/second_stat_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_rounded"
            app:layout_constraintBottom_toBottomOf="@id/week_stat_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/first_stat_container"
            app:layout_constraintTop_toTopOf="@id/first_stat_container">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_limit_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:text="Spending Limit"
                android:textAppearance="@style/TextAppearance.Moner.Regular"
                android:textColor="@color/color_text_secondary"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.alviy.moner.core.designsystem.LinearProgressView
                android:id="@+id/lpv"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_limit_label"
                app:lpv_progress="0.2"
                app:lpv_progressColor="#121212"
                app:lpv_strokeWidth="6dp"
                app:lpv_trackColor="#E4E4E4" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_limit_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="12dp"
                android:text="Rp 4.250.000"
                android:textAppearance="@style/TextAppearance.Moner.Bold"
                android:textColor="#121212"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_limit_total"
                app:layout_constraintVertical_bias="1" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_limit_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="right"
                android:text="Rp 5.000.000"
                android:textAppearance="@style/TextAppearance.Moner.Regular"
                android:textColor="@color/color_text_secondary"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lpv" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--    &lt;!&ndash; Category filter pills &ndash;&gt;-->
    <!--    <androidx.recyclerview.widget.RecyclerView-->
    <!--        android:id="@+id/rv_category"-->
    <!--        android:layout_width="0dp"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:layout_marginHorizontal="16dp"-->
    <!--        android:layout_marginTop="12dp"-->
    <!--        android:layout_marginBottom="16dp"-->
    <!--        android:clipToPadding="false"-->
    <!--        android:orientation="horizontal"-->
    <!--        app:layout_constraintEnd_toEndOf="parent"-->
    <!--        app:layout_constraintStart_toStartOf="parent"-->
    <!--        app:layout_constraintTop_toBottomOf="@id/cl_header"-->
    <!--        tools:itemCount="4"-->
    <!--        tools:listitem="@layout/item_pills" />-->

    <!-- Recent transactions header row -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_recent_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/journal_recent_transactions"
        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="@id/btn_see_all"
        app:layout_constraintEnd_toStartOf="@id/btn_see_all"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_see_all" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_see_all"
        style="@style/Widget.Moner.Button.PillsIcon"
        android:layout_width="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="See all"
        app:strokeWidth="1dp"
        app:strokeColor="#313131"
        app:icon="@drawable/ic_arrow_right_filled"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_header" />

    <!-- Transactions RecyclerView — only scrollable element -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_transactions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_see_all"
        tools:itemCount="4"
        tools:listitem="@layout/item_journal" />

    <!-- Empty state (overlaps rv_transactions area) -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/journal_empty_state"
        android:textAppearance="@style/TextAppearance.Moner.Regular"
        android:textColor="@color/color_text_secondary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_transactions"
        app:layout_constraintEnd_toEndOf="@id/rv_transactions"
        app:layout_constraintStart_toStartOf="@id/rv_transactions"
        app:layout_constraintTop_toTopOf="@id/rv_transactions" />

</androidx.constraintlayout.widget.ConstraintLayout>