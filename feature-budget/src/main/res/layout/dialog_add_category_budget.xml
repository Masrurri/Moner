<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.SheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_24"
            android:text="@string/add_category_budget_title" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/add_category_budget_monthly_limit" />

        <com.alviy.moner.core.designsystem.component.AmountInputView
            android:id="@+id/amount_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_24" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/add_category_budget_category" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:orientation="horizontal"
            tools:listitem="@layout/item_pills" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_new_category"
            style="@style/Widget.Moner.Button.TextAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_24"
            android:text="@string/common_new" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/add_category_budget_period" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_24"
            app:checkedButton="@id/btn_period_monthly"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_period_monthly"
                style="@style/Widget.Moner.SegmentedControl.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_category_budget_monthly" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_period_weekly"
                style="@style/Widget.Moner.SegmentedControl.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/add_category_budget_weekly" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_32"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.Moner.Text.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_category_budget_notify" />

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.Moner.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_category_budget_notify_desc" />
            </LinearLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_notify"
                style="@style/Widget.Moner.Switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_budget"
            style="@style/Widget.Moner.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_category_budget_save" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
