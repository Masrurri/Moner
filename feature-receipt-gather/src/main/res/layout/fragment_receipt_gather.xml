<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_grey"
    tools:context=".ui.ReceiptGatherFragment">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Moner.MaterialCardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="@dimen/spacing_lg"
        android:padding="0dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/iv_google"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_google"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/color_text_heading" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_google_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginTop="10dp"
                android:text="Google Account"
                android:textAppearance="@style/TextAppearance.Moner.SemiBold"
                android:textSize="@dimen/text_size_lg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@id/iv_google"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingConstraints" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_google_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:layout_marginBottom="10dp"
                android:text="Connect your google account."
                android:textAppearance="@style/TextAppearance.Moner.Regular"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_size_sm"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_google"
                app:layout_constraintTop_toBottomOf="@id/tv_google_title"
                app:layout_constraintVertical_bias="0" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_right"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/color_text_secondary" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_fetch"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/color_surface_dark"
        android:text="Fetch Receipt"
        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
        android:textColor="@color/white"
        app:backgroundTint="@color/color_surface_dark"
        app:cornerRadius="@dimen/radius_md"
        app:icon="@drawable/ic_fetch_square"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconSize="20dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_scan"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@color/color_ripple_light" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_scan"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/color_surface_dark"
        android:text="Scan Receipt"
        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
        android:textColor="@color/white"
        app:backgroundTint="@color/color_surface_dark"
        app:cornerRadius="@dimen/radius_md"
        app:icon="@drawable/ic_scan"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconSize="20dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/btn_fetch"
        app:rippleColor="@color/color_ripple_light" />

</androidx.constraintlayout.widget.ConstraintLayout>