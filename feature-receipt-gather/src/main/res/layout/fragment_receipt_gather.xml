<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_grey"
    tools:context=".ui.ReceiptGatherFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_bottom"
        android:backgroundTint="@color/white"
        android:paddingHorizontal="16dp"
        android:translationZ="22dp"
        android:outlineSpotShadowColor="@color/color_shadow"
        android:outlineAmbientShadowColor="@color/color_shadow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Moner.Bold"
            android:textSize="22sp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints"
            android:text="Receipt Gather" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Manual Scan Receipt and Fetched Receipt from Google Account will appear here, click item to record as spending."
            android:textAppearance="@style/TextAppearance.Moner.Regular"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_size_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@id/tv_title"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcv_google"
            style="@style/Widget.Moner.MaterialCardView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#EBEAEA"
            app:cardCornerRadius="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rippleColor="@color/color_ripple_grey"
                android:paddingVertical="8dp"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/iv_google"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_google"
                    app:layout_constraintBottom_toBottomOf="@id/tv_google_desc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_google_desc"
                    app:tint="#8E8E8E" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_google_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Connect your google account to fetch."
                    android:textAppearance="@style/TextAppearance.Moner.SemiBold"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_google"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_receipts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="96dp"
        android:paddingTop="30dp"
        android:layout_marginTop="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:itemCount="4"
        tools:listitem="@layout/item_receipt" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_fetch"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/color_surface_dark"
        android:text="Fetch Receipt"
        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
        android:textColor="@color/white"
        app:backgroundTint="@color/color_surface_dark"
        app:cornerRadius="@dimen/radius_md"
        app:icon="@drawable/ic_fetch_square"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconSize="20dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_scan"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:rippleColor="@color/color_ripple_light" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_scan"
        style="@style/Widget.Material3.Button.IconButton.Filled"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/color_surface_dark"
        android:text="Scan Receipt"
        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
        android:textColor="@color/white"
        app:backgroundTint="@color/color_surface_dark"
        app:cornerRadius="@dimen/radius_md"
        app:icon="@drawable/ic_scan"
        app:iconGravity="textStart"
        app:iconPadding="6dp"
        app:iconSize="20dp"
        app:iconTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/btn_fetch"
        app:rippleColor="@color/color_ripple_light" />

</androidx.constraintlayout.widget.ConstraintLayout>