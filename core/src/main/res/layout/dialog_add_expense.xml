<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.SheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_24"
            android:text="@string/add_expense_title" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.Overline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/add_expense_amount" />

        <com.alviy.moner.core.designsystem.component.AmountInputView
            android:id="@+id/amount_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20" />

        <com.alviy.moner.core.designsystem.component.CustomTextField
            android:id="@+id/tf_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20"
            app:hintText="@string/add_expense_title_hint" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/add_expense_category" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:orientation="horizontal"
            tools:listitem="@layout/item_pills" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_new_category"
            style="@style/Widget.Moner.Button.TextAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20"
            android:text="@string/common_new" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/add_expense_payment_source" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20"
            android:orientation="horizontal"
            tools:listitem="@layout/item_pills" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.FieldLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/add_expense_date" />

        <LinearLayout
            android:id="@+id/row_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20"
            android:background="@drawable/bg_pill_unselected"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_14">

            <ImageView
                android:layout_width="@dimen/size_18"
                android:layout_height="@dimen/size_18"
                android:contentDescription="@null"
                android:src="@drawable/ic_calendar" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_10"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Moner.Medium"
                tools:text="Today, 2 Aug 2026" />

            <ImageView
                android:layout_width="@dimen/size_14"
                android:layout_height="@dimen/size_14"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_right" />

        </LinearLayout>

        <com.alviy.moner.core.designsystem.component.CustomTextField
            android:id="@+id/tf_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_24"
            android:minLines="2"
            app:hintText="@string/add_expense_note_hint" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save_expense"
            style="@style/Widget.Moner.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_expense_save" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
