    <!--        app:layout_constraintTop_toBottomOf="@id/cl_header"-->
    <!--        tools:itemCount="4"-->
    <!--        tools:listitem="@layout/item_pills" />-->

    <!-- Recent transactions header row -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_recent_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_lg"
        android:text="@string/home_recent_transactions"
        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_lg"
        app:layout_constraintBottom_toBottomOf="@id/btn_see_all"
        app:layout_constraintEnd_toStartOf="@id/btn_see_all"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_see_all" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_see_all"
        style="@style/Widget.Moner.Button.PillsIcon"
        android:layout_width="0dp"
        android:layout_marginTop="@dimen/spacing_lg"
        android:layout_marginEnd="@dimen/spacing_lg"
        android:text="@string/home_see_all"
        app:strokeWidth="1dp"
        app:strokeColor="@color/color_stroke_dark"
        app:icon="@drawable/ic_arrow_right_filled"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_header" />

    <!-- Transactions RecyclerView — only scrollable element -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_transactions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/spacing_lg"
        android:layout_marginTop="@dimen/spacing_xs"
        android:clipToPadding="false"
        android:nestedScrollingEnabled="false"
        android:paddingBottom="96dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_see_all"
        tools:itemCount="4"
        tools:listitem="@layout/item_recent_transaction" />

    <!-- Empty state (overlaps rv_transactions area) -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_empty_state"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/spacing_2xl"
        android:text="@string/home_empty_state"
        android:textAppearance="@style/TextAppearance.Moner.Regular"
        android:textColor="@color/color_text_secondary"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_transactions"
        app:layout_constraintEnd_toEndOf="@id/rv_transactions"
        app:layout_constraintStart_toStartOf="@id/rv_transactions"
        app:layout_constraintTop_toTopOf="@id/rv_transactions" />

</androidx.constraintlayout.widget.ConstraintLayout>