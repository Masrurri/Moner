<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_app"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/space_96">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_20">

        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.PageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20"
            android:text="@string/settings_title" />

        <!-- Profile -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Moner.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20">

            <LinearLayout
                android:id="@+id/row_profile"
                style="@style/Widget.Moner.ListRow.Clickable">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="@dimen/size_48"
                    android:layout_height="@dimen/size_48"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:text="@string/settings_profile_initials"
                    android:textAppearance="@style/TextAppearance.Moner.Bold"
                    android:textColor="@color/color_text_on_ink" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_profile_name_placeholder"
                        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
                        android:textSize="@dimen/text_16" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tv_profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_profile_email_placeholder"
                        android:textAppearance="@style/TextAppearance.Moner.Regular"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_13" />
                </LinearLayout>

                <ImageView style="@style/Widget.Moner.ListRow.Chevron" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Preferences -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/settings_section_preferences" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Moner.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/Widget.Moner.ListRow">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Widget.Moner.ListRow.Title"
                        android:text="@string/settings_currency" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_currency_value"
                        android:textAppearance="@style/TextAppearance.Moner.Regular"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_14" />
                </LinearLayout>

                <View style="@style/Widget.Moner.Hairline" />

                <LinearLayout style="@style/Widget.Moner.ListRow">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Widget.Moner.ListRow.Title"
                        android:text="@string/settings_dark_mode" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_dark_mode"
                        style="@style/Widget.Moner.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View style="@style/Widget.Moner.Hairline" />

                <LinearLayout style="@style/Widget.Moner.ListRow">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Widget.Moner.ListRow.Title"
                        android:text="@string/settings_notifications" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_notifications"
                        style="@style/Widget.Moner.Switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tools -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/settings_section_tools" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Moner.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/row_import_excel"
                    style="@style/Widget.Moner.ListRow.Clickable">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Widget.Moner.ListRow.Title"
                        android:text="@string/settings_import_excel" />

                    <ImageView style="@style/Widget.Moner.ListRow.Chevron" />
                </LinearLayout>

                <View style="@style/Widget.Moner.Hairline" />

                <LinearLayout
                    android:id="@+id/row_export_excel"
                    style="@style/Widget.Moner.ListRow.Clickable">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Widget.Moner.ListRow.Title"
                        android:text="@string/settings_export_excel" />

                    <ImageView style="@style/Widget.Moner.ListRow.Chevron" />
                </LinearLayout>

                <View style="@style/Widget.Moner.Hairline" />

                <LinearLayout
                    android:id="@+id/row_backup_restore"
                    style="@style/Widget.Moner.ListRow.Clickable">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Widget.Moner.ListRow.Title"
                        android:text="@string/settings_backup_restore" />

                    <ImageView style="@style/Widget.Moner.ListRow.Chevron" />
                </LinearLayout>

                <View
                    android:id="@+id/divider_generate_sample"
                    style="@style/Widget.Moner.Hairline" />

                <LinearLayout
                    android:id="@+id/row_generate_sample"
                    style="@style/Widget.Moner.ListRow.Clickable">

                    <com.google.android.material.textview.MaterialTextView
                        style="@style/Widget.Moner.ListRow.Title"
                        android:text="@string/settings_generate_sample_data" />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_8"
                        android:background="@drawable/bg_pill_unselected"
                        android:paddingHorizontal="@dimen/space_8"
                        android:paddingVertical="@dimen/space_2"
                        android:text="@string/settings_dev_tag"
                        android:textAppearance="@style/TextAppearance.Moner.SemiBold"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="@dimen/text_10" />

                    <ImageView style="@style/Widget.Moner.ListRow.Chevron" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Danger zone -->
        <com.google.android.material.textview.MaterialTextView
            style="@style/Widget.Moner.Text.Overline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:text="@string/settings_section_danger_zone" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Moner.Card.Flat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_20">

            <LinearLayout
                android:id="@+id/row_clear_database"
                style="@style/Widget.Moner.ListRow.Clickable">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Widget.Moner.ListRow.Title"
                    android:text="@string/settings_clear_database"
                    android:textAppearance="@style/TextAppearance.Moner.SemiBold"
                    android:textColor="@color/color_danger" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_app_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Moner.Regular"
            android:textColor="@color/color_text_tertiary"
            android:textSize="@dimen/text_12"
            tools:text="Moner v1.0" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
