<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Moner color tokens.
        Themed tokens have a dark counterpart in values-night/colors.xml.
        "Fixed" tokens intentionally look the same in both themes; do not add them to values-night.
    -->

    <!-- Base (themed: black/white swap in dark mode) -->
    <color name="black">#111111</color>
    <color name="white">#FFFFFFFF</color>
    <color name="transparent">#00000000</color>

    <!-- Surfaces -->
    <color name="color_bg_app">#F7F7F5</color>
    <color name="color_bg_surface">#FFFFFF</color>
    <color name="color_surface_ink">#111111</color>
    <color name="color_stroke_hairline">#EAEAEA</color>
    <color name="color_shadow">#29000000</color>
    <color name="color_ripple">#1F000000</color>
    <color name="color_input_bg">#F1F1EF</color>

    <!-- Text -->
    <color name="color_text_primary">#111111</color>
    <color name="color_text_secondary">#6E6E6E</color>
    <color name="color_text_tertiary">#A0A0A0</color>
    <color name="color_text_on_ink">#FFFFFF</color>

    <!-- Accent -->
    <color name="color_accent_neon">#D6FF3F</color>
    <color name="color_on_neon">#111111</color>
    <color name="color_danger">#E4483C</color>

    <!-- Buttons (flip with theme) -->
    <color name="color_button_primary_bg">#111111</color>
    <color name="color_button_primary_bg_pressed">#2B2B2B</color>
    <color name="color_button_primary_text">#FFFFFF</color>

    <!-- Pills / chips -->
    <color name="color_pill_bg_unselected">#F1F1EF</color>
    <color name="color_pill_text_unselected">#111111</color>

    <!-- Bottom nav -->
    <color name="color_nav_icon_inactive">#A0A0A0</color>
    <color name="color_nav_active_content">#FFFFFF</color>

    <!-- Fixed palette: same in light and dark -->
    <color name="color_fixed_surface_light">#EDEEF0</color>
    <color name="color_fixed_surface_dark">#1C1C1C</color>
    <color name="color_fixed_background_dark">#151515</color>
    <color name="color_fixed_stroke_dark">#313131</color>
    <color name="color_fixed_text_dark">#121212</color>
    <color name="color_fixed_text_muted">#ABABAB</color>
    <color name="color_fixed_ripple_light">#33C1C1C1</color>
    <color name="color_fixed_on_ink_secondary">#B3FFFFFF</color>
    <color name="color_fixed_white">#FFFFFF</color>

    <color name="color_button_primary_bg_disabled">#4D111111</color>
    <color name="color_month_chip_bg">#DCDDDE</color>
    <color name="color_month_chip_ripple">#33A8A8A8</color>
    <color name="color_nav_indicator">#333333</color>
    <color name="color_wheel_highlight">#F6F6F6</color>
    <color name="color_wheel_item_selected">#FF000000</color>
    <color name="color_wheel_item_unselected">#FF888888</color>
    <color name="color_progress_track_default">#33000000</color>
    <color name="color_progress_track_light">#E4E4E4</color>
    <color name="color_progress_track_on_ink">#33FFFFFF</color>
</resources>
