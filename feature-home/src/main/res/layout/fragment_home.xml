<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_dark"
    tools:context=".ui.HomeFragment">

    <!-- Total expense card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_bottom"
        android:padding="@dimen/spacing_lg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_greeting"
            app:layout_constraintBottom_toBottomOf="@id/tv_welcome"/>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textSize="@dimen/text_size_lg"
            android:layout_marginStart="@dimen/spacing_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints"
            android:text="@string/home_greeting" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/home_welcome_back"
            android:textAppearance="@style/TextAppearance.Moner.Regular"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_size_sm"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toBottomOf="@id/tv_greeting" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_total_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:letterSpacing="0.02"
            android:text="@string/home_total_spend"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/color_text_secondary"
            android:textSize="@dimen/text_size_lg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_welcome" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_selected_month"
            style="@style/Widget.Moner.Button.PillsIcon"
            android:layout_width="0dp"
            android:text="@string/home_select_time_default"
            android:textSize="@dimen/text_size_sm"
            app:iconTint="@color/color_text_secondary"
            android:textColor="@color/color_text_secondary"
            android:backgroundTint="@color/color_bg_chip"
            app:rippleColor="@color/color_ripple_grey"
            app:icon="@drawable/ic_arrow_bottom_filled"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tv_total_label"
            app:layout_constraintTop_toTopOf="@id/tv_total_label" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_total_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xs"
            android:textAppearance="@style/TextAppearance.Moner.Bold"
            android:textColor="@color/color_text_heading"
            android:textSize="@dimen/text_size_display"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_selected_month"
            tools:text="Rp 4.250.000" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_spend"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:backgroundTint="@color/color_surface_dark"
            android:text="@string/home_action_spend"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/white"
            app:backgroundTint="@color/color_surface_dark"
            app:cornerRadius="@dimen/radius_md"
            app:icon="@drawable/ic_add_square"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:layout_constraintHorizontal_bias="0"
            app:iconTint="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_stats"
            app:layout_constraintTop_toBottomOf="@id/tv_total_amount"
            app:rippleColor="@color/color_ripple_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fetch"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:backgroundTint="@color/white"
            android:text="@string/home_action_fetch"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:cornerRadius="@dimen/radius_md"
            app:icon="@drawable/ic_fetch_square"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/black"
            app:layout_constraintEnd_toStartOf="@id/btn_stats"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_total_amount"
            app:rippleColor="@color/color_ripple_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_stats"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:layout_marginHorizontal="@dimen/spacing_xs"
            android:backgroundTint="@color/white"
            android:text="@string/home_action_stats"
            android:textAppearance="@style/TextAppearance.Moner.SemiBold"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:cornerRadius="@dimen/radius_md"
            app:icon="@drawable/ic_chart_square"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="16dp"
            app:iconTint="@color/black"
            app:layout_constraintEnd_toStartOf="@id/btn_spend"
            app:layout_constraintStart_toEndOf="@id/btn_fetch"
            app:layout_constraintTop_toBottomOf="@id/tv_total_amount"
            app:rippleColor="@color/color_ripple_light" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/first_stat_container"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_rounded"
            app:layout_constraintEnd_toStartOf="@+id/second_stat_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_fetch">

            <ImageView
                android:id="@+id/iv_spend_today"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:src="@drawable/ic_export"
                app:layout_constraintBottom_toBottomOf="@id/tv_spend_today_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_spend_today_label" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_today_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_md"
                android:text="@string/home_spend_today"
                style="@style/Widget.Moner.StatLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_today"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_today_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_sm"
                tools:text="Rp 4.250.000"
                style="@style/Widget.Moner.StatValue"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_today"
                app:layout_constraintTop_toBottomOf="@id/tv_spend_today_label"
                app:layout_constraintVertical_bias="1" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/week_stat_container"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginEnd="@dimen/spacing_md"
            android:background="@drawable/bg_rounded"
            app:layout_constraintEnd_toStartOf="@+id/second_stat_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/first_stat_container">

            <ImageView
                android:id="@+id/iv_spend_week"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="@dimen/spacing_md"
                android:src="@drawable/ic_export"
                app:layout_constraintBottom_toBottomOf="@id/tv_spend_week_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_spend_week_label" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_week_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_marginEnd="@dimen/spacing_md"
                android:text="@string/home_spend_week"
                style="@style/Widget.Moner.StatLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_week"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_spend_week_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:layout_marginEnd="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_sm"
                tools:text="Rp 4.250.000"
                style="@style/Widget.Moner.StatValue"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_spend_week"
                app:layout_constraintTop_toBottomOf="@id/tv_spend_week_label"
                app:layout_constraintVertical_bias="1" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/second_stat_container"
            android:foreground="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_rounded"
            app:layout_constraintBottom_toBottomOf="@id/week_stat_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/first_stat_container"
            app:layout_constraintTop_toTopOf="@id/first_stat_container">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_limit_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/home_spend_limit"
                android:textAppearance="@style/TextAppearance.Moner.Regular"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_size_sm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.alviy.moner.core.designsystem.LinearProgressView
                android:id="@+id/lpv"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_xs"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_limit_label"
                app:lpv_progress="0.2"
                app:lpv_progressColor="@color/color_text_heading"
                app:lpv_strokeWidth="6dp"
                app:lpv_trackColor="@color/color_progress_track" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_limit_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginTop="@dimen/spacing_2xs"
                android:layout_marginBottom="@dimen/spacing_md"
                tools:text="Rp 4.250.000"
                android:textAppearance="@style/TextAppearance.Moner.Bold"
                android:textColor="@color/color_text_heading"
                android:textSize="@dimen/text_size_lg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_limit_total"
                app:layout_constraintVertical_bias="1" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_limit_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_md"
                android:gravity="right"
                tools:text="Rp 5.000.000"
                android:textAppearance="@style/TextAppearance.Moner.Regular"
                android:textColor="@color/color_text_secondary"
                android:textSize="@dimen/text_size_xs"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lpv" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--    &lt;!&ndash; Category filter pills &ndash;&gt;-->
    <!--    <androidx.recyclerview.widget.RecyclerView-->
    <!--        android:id="@+id/rv_category"-->
    <!--        android:layout_width="0dp"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:layout_marginHorizontal="@dimen/spacing_lg"-->
    <!--        android:layout_marginTop="@dimen/spacing_md"-->
    <!--        android:layout_marginBottom="@dimen/spacing_lg"-->
    <!--        android:clipToPadding="false"-->
    <!--        android:orientation="horizontal"-->
    <!--        app:layout_constraintEnd_toEndOf="parent"-->
