<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Moner design system styles. Feature layouts should reference these instead of repeating attributes.
        Naming: TextAppearance.Moner.*  = font weight/size/color
                Widget.Moner.Text.*     = a TextView role (appearance + overrides)
                Widget.Moner.Button.*   = button variants
                Widget.Moner.Card.*     = card variants
                Widget.Moner.ListRow.*  = settings-style rows
                ShapeAppearance.Moner.* = shapes
    -->

    <!-- ===================================================================== Typography -->

    <style name="TextAppearance">
        <item name="fontFamily">@font/inter_family</item>
    </style>

    <style name="TextAppearance.Moner">
        <item name="fontFamily">@font/inter_family</item>
    </style>

    <style name="TextAppearance.Moner.Thin" parent="TextAppearance.Moner">
        <item name="android:textFontWeight">100</item>
        <item name="android:textColor">@color/color_text_tertiary</item>
        <item name="android:textSize">@dimen/text_12</item>
    </style>

    <style name="TextAppearance.Moner.Regular" parent="TextAppearance.Moner">
        <item name="font">@font/inter</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <style name="TextAppearance.Moner.Bold" parent="TextAppearance.Moner">
        <item name="font">@font/inter_bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">@dimen/text_16</item>
    </style>

    <style name="TextAppearance.Moner.Medium" parent="TextAppearance.Moner">
        <item name="font">@font/inter_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <style name="TextAppearance.Moner.SemiBold" parent="TextAppearance.Moner">
        <item name="font">@font/inter_semibold</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">@dimen/text_14</item>
    </style>

    <style name="TextAppearance.Moner.AmountDisplay" parent="TextAppearance.Moner">
        <item name="font">@font/inter_bold</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textSize">@dimen/text_40</item>
    </style>

    <!-- ===================================================================== Text roles -->

    <!-- Screen heading: "Budget", "Settings" -->
    <style name="Widget.Moner.Text.PageTitle" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Moner.Bold</item>
        <item name="android:textSize">@dimen/text_26</item>
    </style>

    <!-- Centered sheet heading: "Add Expense", "Add Category Budget" -->
    <style name="Widget.Moner.Text.SheetTitle" parent="">
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Moner.Bold</item>
        <item name="android:textSize">@dimen/text_18</item>
    </style>

    <!-- Upper-case small label: "PREFERENCES", "AMOUNT *" -->
    <style name="Widget.Moner.Text.Overline" parent="">
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAppearance">@style/TextAppearance.Moner.SemiBold</item>
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:textSize">@dimen/text_12</item>
    </style>

    <!-- Form field label above an input: "Category *" -->
    <style name="Widget.Moner.Text.FieldLabel" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Moner.SemiBold</item>
    </style>

    <!-- Secondary helper line under a title -->
    <style name="Widget.Moner.Text.Caption" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Moner.Regular</item>
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:textSize">@dimen/text_12</item>
    </style>

    <!-- Centered empty-state message -->
    <style name="Widget.Moner.Text.EmptyState" parent="">
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Moner.Regular</item>
        <item name="android:textColor">@color/color_text_secondary</item>
    </style>

    <!-- ===================================================================== Buttons -->

    <!-- Full-width filled call to action: "Save Expense", "Save Budget" -->
    <style name="Widget.Moner.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/color_btn_primary</item>
        <item name="android:elevation">0dp</item>
        <item name="android:paddingVertical">@dimen/space_16</item>
        <item name="android:textAppearance">@style/TextAppearance.Moner.Bold</item>
        <item name="android:textColor">@color/color_text_btn_primary</item>
        <item name="cornerRadius">@dimen/radius_16</item>
        <item name="rippleColor">@color/color_ripple</item>
    </style>

    <!-- Fully rounded centered button at the bottom of a small dialog -->
    <style name="Widget.Moner.Button.Dialog" parent="Widget.Material3.Button">
        <item name="android:elevation">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Moner.Bold</item>
        <item name="android:textSize">@dimen/text_16</item>
        <item name="rippleColor">@color/color_ripple</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Moner.Pill</item>
    </style>

    <style name="Widget.Moner.Button.Dialog.Primary">
        <item name="android:backgroundTint">@color/color_btn_primary</item>
        <item name="android:textColor">@color/color_text_btn_primary</item>
        <item name="android:paddingHorizontal">@dimen/space_36</item>
    </style>

    <style name="Widget.Moner.Button.Dialog.Inverse">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:paddingHorizontal">@dimen/space_14</item>
    </style>

    <!-- "+ New" text button under a pill list -->
    <style name="Widget.Moner.Button.TextAdd" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.Moner.SemiBold</item>
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="icon">@drawable/ic_plus</item>
        <item name="iconTint">@color/color_text_primary</item>
    </style>

    <!-- Home header quick actions (Fetch / Stats / Spend) -->
    <style name="Widget.Moner.Button.QuickAction" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="android:textAppearance">@style/TextAppearance.Moner.SemiBold</item>
        <item name="cornerRadius">@dimen/radius_16</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/space_6</item>
        <item name="iconSize">@dimen/size_16</item>
        <item name="rippleColor">@color/color_fixed_ripple_light</item>
    </style>

    <style name="Widget.Moner.Button.QuickAction.Dark">
        <item name="android:backgroundTint">@color/color_fixed_surface_dark</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/color_fixed_surface_dark</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.Moner.Button.QuickAction.Light">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/white</item>
        <item name="iconTint">@color/black</item>
    </style>

    <!-- Small pill with a trailing icon: "This Month ▾", "See all >" -->
    <style name="Widget.Moner.Button.PillsIcon" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
        <item name="android:paddingTop">@dimen/space_6</item>
        <item name="android:paddingBottom">@dimen/space_6</item>
        <item name="android:backgroundTint">@color/color_fixed_surface_dark</item>
        <item name="android:textAppearance">@style/TextAppearance.Moner.SemiBold</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_12</item>
        <item name="backgroundTint">@color/white</item>
        <item name="cornerRadius">@dimen/radius_16</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconPadding">@dimen/space_6</item>
        <item name="iconSize">@dimen/size_12</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">@color/color_fixed_ripple_light</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Monthly / Weekly segmented control (2 fixed options via MaterialButtonToggleGroup) -->
    <style name="Widget.Moner.SegmentedControl.Button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.Moner.SemiBold</item>
        <item name="android:textColor">@color/color_pill_text</item>
        <item name="backgroundTint">@color/color_pill_bg</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Moner.Pill</item>
        <item name="rippleColor">@color/color_ripple</item>
    </style>

    <!-- ===================================================================== Inputs -->

    <style name="Widget.Moner.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/color_switch_thumb</item>
        <item name="trackTint">@color/color_switch_track</item>
    </style>

    <!-- ===================================================================== Cards -->

    <style name="Widget.Moner.MaterialCardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_bg_surface</item>
        <item name="android:outlineAmbientShadowColor">@color/color_shadow</item>
        <item name="android:outlineSpotShadowColor">@color/color_shadow</item>
        <item name="cardElevation">@dimen/elevation_18</item>
        <item name="strokeWidth">0dp</item>
        <item name="strokeColor">@color/transparent</item>
    </style>

    <!-- Flat surface card used for grouped content (settings sections, budget list) -->
    <style name="Widget.Moner.Card.Flat" parent="Widget.Moner.MaterialCardView">
        <item name="cardCornerRadius">@dimen/radius_16</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Moner.Card.BottomNav" parent="Widget.Moner.MaterialCardView">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Moner.BottomNav</item>
    </style>

    <!-- ===================================================================== List rows -->

    <style name="Widget.Moner.ListRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">@dimen/space_16</item>
    </style>

    <style name="Widget.Moner.ListRow.Clickable">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Row label that fills the row: place inside Widget.Moner.ListRow -->
    <style name="Widget.Moner.ListRow.Title" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textAppearance">@style/TextAppearance.Moner.Medium</item>
        <item name="android:textSize">@dimen/text_15</item>
    </style>

    <style name="Widget.Moner.ListRow.Chevron" parent="">
        <item name="android:layout_width">@dimen/size_16</item>
        <item name="android:layout_height">@dimen/size_16</item>
        <item name="android:src">@drawable/ic_arrow_right</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Widget.Moner.Hairline" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/size_1</item>
        <item name="android:background">@drawable/bg_row_hairline</item>
        <item name="android:layout_marginStart">@dimen/space_16</item>
        <item name="android:layout_marginEnd">@dimen/space_16</item>
    </style>

    <!-- ===================================================================== Dialogs & sheets -->

    <style name="Widget.Moner.Dialog.Rounded" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <style name="Widget.Moner.FullScreenSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Moner.FullScreenSheet.Modal</item>
    </style>

    <style name="Widget.Moner.FullScreenSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.Moner.Sheet</item>
        <item name="backgroundTint">@color/color_bg_app</item>
    </style>

    <!-- ===================================================================== Bottom navigation -->

    <style name="Widget.Moner.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/color_nav_indicator</item>
        <item name="android:width">@dimen/size_90</item>
        <item name="android:height">@dimen/size_40</item>
        <item name="marginHorizontal">@dimen/space_2</item>
    </style>

    <!-- ===================================================================== Shapes -->

    <style name="ShapeAppearance.Moner.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.Moner.BottomNav" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_40</item>
        <item name="cornerSizeTopRight">@dimen/radius_40</item>
        <item name="cornerSizeBottomLeft">@dimen/radius_40</item>
        <item name="cornerSizeBottomRight">@dimen/radius_40</item>
    </style>

    <style name="ShapeAppearance.Moner.Sheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/radius_20</item>
        <item name="cornerSizeTopRight">@dimen/radius_20</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>
